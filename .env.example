# -----------------------------------------------------------------------
# api_label — Environment configuration template
# Copy to .env and fill in production values before starting the service.
# -----------------------------------------------------------------------

# Application
APP_NAME=api_label
DEBUG=false
ROOT_PATH=/label

# Database (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/api_label_psql

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_secret_key_min_32_chars_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis (DB 3 reserved for api_label)
REDIS_URL=redis://localhost:6379/3

# Celery (uses same Redis DB)
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# External barcode API
BARCODE_API_URL=https://api.pibico.es/barcode
BARCODE_API_KEY=your-barcode-api-key

# PDF output directory (must be writable by erpnext user)
PDF_OUTPUT_DIR=/tmp/api_label_pdfs

# i18n
DEFAULT_LANGUAGE=es
SUPPORTED_LANGUAGES=["es", "en"]
